# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Required! Get this free in 30 seconds from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""

# (OPTIONAL) OMDB_API_KEY: Instant free key from https://www.omdbapi.com/apikey.aspx
# Not required! The bot includes a built-in keyless IMDb + TVmaze search engine.
OMDB_API_KEY=""

# (OPTIONAL) TMDB_API_KEY: Optional fallback from https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# (OPTIONAL) Radarr API Configuration (Phase 6 Automation)
RADARR_URL="http://your-radarr-ip:7878"
RADARR_API_KEY="your_radarr_api_key"
RADARR_ROOT_FOLDER_PATH="/data/media/movies"
RADARR_QUALITY_PROFILE_ID="1"

# (OPTIONAL) Sonarr API Configuration (Phase 6 Automation)
SONARR_URL="http://your-sonarr-ip:8989"
SONARR_API_KEY="your_sonarr_api_key"
SONARR_ROOT_FOLDER_PATH="/data/media/tv"
SONARR_QUALITY_PROFILE_ID="1"
